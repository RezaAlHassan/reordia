# Set these as server-side environment variables on the hosting platform.
# Never put the App Secret in HTML or browser JavaScript.
META_APP_ID=
META_APP_SECRET=
REORDIA_ADMIN_PASSWORD=
# Generated by prepare-cloudflare-env.mjs. Keep the same key after saving Pages.
PAGE_TOKEN_ENCRYPTION_KEY=

# Optional: this is the version used by the current backend.
META_GRAPH_VERSION=v24.0
